# Applicazione
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
TIMEZONE=Europe/Rome
DEMO_MODE=false

# Provider dati e quote (solo backend)
# espn = dati reali pubblici senza chiave (default); api-football = richiede API_FOOTBALL_KEY.
# Con DEMO_MODE=true si usano i dati dimostrativi e DATA_PROVIDER viene ignorato.
DATA_PROVIDER=espn
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
BOOKMAKER_NAME=Bet365
PROVIDER_TIMEOUT_MS=15000
MATCH_DAYS_AHEAD=7
MAX_FIXTURES=400
AUTO_REFRESH_MINUTES=180

# Motore deterministico
MONTE_CARLO_RUNS=50000
TOP_PICKS_MAX_FIXTURES=400
TOP_PICKS_CONCURRENCY=3
TOP_PICKS_MIN_PROBABILITY=0.55
TOP_PICKS_MIN_CONFIDENCE=45
TOP_PICKS_MIN_DATA_QUALITY=40
TOP_PICKS_REQUIRE_POSITIVE_EV=false

# Registro previsioni e validazione post-partita
# Live: file JSONL append-only (montare un volume persistente su data/). Demo: sempre in memoria.
PREDICTION_LEDGER_ENABLED=true
PREDICTION_LEDGER_PATH=data/predictions.jsonl
# Diario giocate sul server: nessun login, attivalo solo su un'istanza privata o locale.
BET_JOURNAL_ENABLED=false
BET_JOURNAL_PATH=data/bet-journal.jsonl
PREDICTION_LEDGER_MAX_RECORDS=20000
# Attesa dopo il calcio d'inizio prima di cercare il risultato, intervallo minimo tra controlli e richieste massime per controllo.
RESULT_SETTLEMENT_DELAY_MINUTES=150
RESULT_SETTLEMENT_INTERVAL_MINUTES=15
RESULT_SETTLEMENT_MAX_PER_RUN=40

# Cache e sicurezza
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=2000
MAX_BODY_BYTES=1048576
REQUESTS_PER_MINUTE=90
EXPENSIVE_REQUESTS_PER_MINUTE=12
TRUST_PROXY=false
ADMIN_API_TOKEN=

# Hybrid AI. Provider: anthropic (consigliato) | gemini | openai | claude (claude = runtime Artifact claude.ai, senza chiave)
AI_MODE=active
AI_PROVIDER=gemini

# Anthropic Claude (consigliato)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL_DEFAULT=claude-opus-5-5
ANTHROPIC_MODEL_CHALLENGE=claude-opus-5-5
ANTHROPIC_MODEL_EXPLANATION=claude-opus-5-5

# Google Gemini (predefinito, economico)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL_DEFAULT=gemini-2.5-flash-lite
GEMINI_MODEL_CHALLENGE=gemini-2.5-flash
GEMINI_MODEL_EXPLANATION=gemini-2.5-flash-lite

# OpenAI (alternativa: imposta AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_DEFAULT=gpt-5.6-luna
OPENAI_MODEL_CHALLENGE=gpt-5.6-terra
OPENAI_MODEL_EXPLANATION=gpt-5.6-luna

# AI_MODEL_DEFAULT / CHALLENGE / EXPLANATION, se presenti, sovrascrivono
# i valori specifici del provider.
AI_REASONING_EFFORT=low
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=900
AI_MAX_INPUT_CHARS=24000
AI_MAX_CALLS_PER_ANALYSIS=5
AI_MAX_CONCURRENCY=2
AI_AGENT_CACHE_TTL_SECONDS=3600

# Hard limit AI in memoria
AI_DAILY_CALL_LIMIT=100
AI_DAILY_TOKEN_LIMIT=250000
AI_DAILY_COST_LIMIT_USD=3

# Policy deterministica degli aggiustamenti
AI_MIN_EFFECT_CONFIDENCE=0.55
# Riduce gli effetti successivi che riutilizzano la stessa evidenza tra agenti.
AI_DUPLICATE_EVIDENCE_SCALE=0.50
AI_MAX_TACTICAL_XG_DELTA=0.10
AI_MAX_NEWS_XG_DELTA=0.04
AI_MAX_COMPETITION_XG_DELTA=0.06
AI_MAX_TOTAL_XG_DELTA=0.20
AI_MAX_PROBABILITY_SHIFT_PP=5
AI_MAX_CHALLENGE_CONFIDENCE_PENALTY=8

# Top Picks: AI attiva solo sulla shortlist deterministica
TOP_PICKS_AI_ENABLED=true
TOP_PICKS_AI_SHORTLIST_MULTIPLIER=1

# Stima prudenziale per il modello piu costoso usato dal profilo Gemini.
# Aggiornare questi valori se si cambia provider/modello; 0 disabilita la stima.
AI_INPUT_COST_PER_MILLION=0.30
AI_CACHED_INPUT_COST_PER_MILLION=0.03
AI_OUTPUT_COST_PER_MILLION=2.50

# Margine del bookmaker: shin (predefinito, corregge il favorite-longshot bias) oppure proportional.
DEVIG_METHOD=shin
